# Copy to .env and fill in. Never commit .env.

# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-from-BotFather
# Your numeric chat id (get it from @userinfobot). Only this chat can use the bot.
MY_CHAT_ID=123456789

# ── Supabase (service_role key — bypasses RLS; keep secret) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=post-images

# ── Who does what ────────────────────────────────────────
# Primary writer (outline, drafts, de-AI pass): groq | openrouter | modelscope | zenmux | nvidia
WRITER_PROVIDER=groq
# Tried in order when the primary fails (error, rate limit, daily quota, empty/cut-off reply).
# provider:model, comma-separated; entries whose provider has no API key are skipped. Empty = no fallback.
# Default (leave commented to use it): the usable OpenRouter free models, ModelScope, the
# 429-prone OpenRouter ones, then NVIDIA nemotron. See DEFAULT_WRITER_FALLBACKS in app/config.py.
# WRITER_FALLBACKS=openrouter:dots-studio/dots-3-note-preview:free,openrouter:nvidia/nemotron-3-super-120b-a12b:free,openrouter:nex-agi/nex-n2.5-pro:free,modelscope:deepseek-ai/DeepSeek-V4-Pro,modelscope:Qwen/Qwen3.5-397B-A17B,modelscope:MiniMax/MiniMax-M3,modelscope:zai-org/GLM-5.2,zenmux:dots-studio/dots3-note-prev,zenmux:z-ai/glm-4.7-flash-free,zenmux:sapiens-ai/agnes-2.5-flash,zenmux:atria-asi/atria-dawn-preview,openrouter:qwen/qwen3.8-27b:free,openrouter:google/gemma-4-31b-it:free,openrouter:z-ai/glm-5.2:free,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,openrouter:openrouter/free,nvidia:nvidia/nemotron-3-super-120b-a12b
# Research: browse (Groq gpt-oss + browser_search, facts checked against the pages it opened) | tavily
RESEARCH_PROVIDER=browse
# After the de-AI pass, one extra call removes numbers the research doesn't support.
NUMBER_REPAIR=true

# ── Groq (writer + browsing research) — console.groq.com ──
GROQ_API_KEY=gsk_...
# Optional paid Groq account (Developer plan, pay per token): failover writer + browser when the
# free account hits its limit. Capped per IST day; also set a spend limit in the Groq console.
GROQ_API_KEY_2=
GROQ2_DAILY_USD=0.25
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# low keeps gpt-oss reasoning short and out of the output
GROQ_REASONING_EFFORT=low

# ── OpenRouter (free models: writer fallback chain) — openrouter.ai ──
# Free tier without credits: ~50 requests/day and 20/min across all :free models.
OPENROUTER_API_KEY=sk-or-v1-...
# Used only when WRITER_PROVIDER=openrouter
OPENROUTER_CHAT_MODEL=dots-studio/dots-3-note-preview:free

# ── ModelScope (free API inference: writer fallback chain) — modelscope.ai ──
# The account must be bound to an Alibaba Cloud account first (Settings → Account),
# otherwise every call returns 401 and the chain skips ModelScope.
MODELSCOPE_API_KEY=ms-...
MODELSCOPE_BASE_URL=https://api-inference.modelscope.ai/v1
# Used only when WRITER_PROVIDER=modelscope
MODELSCOPE_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Pro

# ── ZenMux (free models: writer fallback chain) — zenmux.ai ──
# A pay-as-you-go key got 403 on the free models (2026-09-23); check the key type/balance in the dashboard.
ZENMUX_API_KEY=sk-mg-v1-...
# Used only when WRITER_PROVIDER=zenmux
ZENMUX_CHAT_MODEL=dots-studio/dots3-note-prev

# ── NVIDIA NIM (embeddings + FLUX images; optional writer) — build.nvidia.com ──
# Free tier: ~40 req/min per model, ~1000 credits. Fine for one post/day.
NVIDIA_API_KEY=nvapi-...
# Only used when WRITER_PROVIDER=nvidia. Check quality first: python scripts/validate_writer.py
NVIDIA_CHAT_MODEL=deepseek-ai/deepseek-v4.1-flash
# Must output 2048-dim vectors (schema is vector(2048)).
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_MAX_TOKENS=4096
# NVIDIA chat models reason by default: slow, token-hungry, and reasoning can leak into drafts.
NVIDIA_DISABLE_THINKING=true
DRAFT_TEMPERATURE=0.85
# Fold 𝐛𝐨𝐥𝐝-Unicode lettering to plain text in drafts (off: allowed on LinkedIn per the author's profile)
UNBOLD_DRAFTS=false

# ── Tavily (optional) ────────────────────────────────────
# Required only for RESEARCH_PROVIDER=tavily; otherwise used as a fallback when
# browsing finds fewer than 3 verified facts, and for the 2 PM news topic.
TAVILY_API_KEY=

# ── Bright Data (optional) — brightdata.com ──
# Only for scripts/scrape_linkedin_posts.py (pulls your own past posts + likes/comments for the voice corpus).
# The account must be active (payment method added), otherwise the API answers "Customer is not active".
BRIGHTDATA_API_KEY=
# Hard cap on Bright Data records per IST day (1 per draft run for fresh research, 1 per pasted X/LinkedIn link)
BRIGHTDATA_DAILY_RECORDS=10
# ChatGPT Search facts in every draft run (true/false)
BRIGHTDATA_RESEARCH=true

# ── Jev (TypeSafe AI) — optional decision gate for chat-started drafts ──
JEV_API_KEY=

# ── NewsData.io — optional, first source for news topics (free: 200 credits/day, ~12 h delay) ──
NEWSDATA_API_KEY=

# ── LinkedIn ─────────────────────────────────────────────
# LinkedIn-Version header (YYYYMM). Versions sunset after ~1 year; bump when announced.
LINKEDIN_API_VERSION=202601
# Only needed by scripts/linkedin_auth.py (tokens themselves live in the `settings` table).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# ── Content ──────────────────────────────────────────────
# Source for the 2 PM fallback topic (comma-separated)
NICHE_KEYWORDS=AI agents, startups, edtech, student founders

# ── Timeouts (seconds) & logging ─────────────────────────
HTTP_TIMEOUT=30
LLM_TIMEOUT=180
IMAGE_TIMEOUT=240
RESEARCH_TIMEOUT=60
LOG_LEVEL=INFO
